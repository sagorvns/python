# Copy to .env and fill in. LLM: set one of these.
# Google Gemini (recommended if you have Gemini API key)
# GOOGLE_API_KEY=your-gemini-api-key-here

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: model overrides
# GOOGLE_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: DynamoDB for conversation checkpoints (multi-turn)
# DYNAMODB_CHECKPOINT_TABLE=ciffly-chatbot-checkpoints

# LOG_LEVEL=INFO
# CORS_ORIGIN=https://your-frontend.com
